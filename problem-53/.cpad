{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_three_sum_py": {
            "label": "Test (test_three_sum.py)",
            "command": "python src/test_three_sum.py"
        },
        "test_test_triplets_py": {
            "label": "Test (test_triplets.py)",
            "command": "python src/test_triplets.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_three_sum_py": {
            "label": "ipdb Test (test_three_sum.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_three_sum.py"
        },
        "dbg_test_test_triplets_py": {
            "label": "ipdb Test (test_triplets.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_triplets.py"
        }
    }
}
