{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_min_window_py": {
            "label": "Test (test_min_window.py)",
            "command": "python src/test_min_window.py"
        },
        "test_test_window_py": {
            "label": "Test (test_window.py)",
            "command": "python src/test_window.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_min_window_py": {
            "label": "ipdb Test (test_min_window.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_min_window.py"
        },
        "dbg_test_test_window_py": {
            "label": "ipdb Test (test_window.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_window.py"
        }
    }
}
