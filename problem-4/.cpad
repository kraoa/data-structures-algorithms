{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_lru_cache_py": {
            "label": "Test (test_lru_cache.py)",
            "command": "python src/test_lru_cache.py"
        },
        "test_test_operations_py": {
            "label": "Test (test_operations.py)",
            "command": "python src/test_operations.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_lru_cache_py": {
            "label": "ipdb Test (test_lru_cache.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_lru_cache.py"
        },
        "dbg_test_test_operations_py": {
            "label": "ipdb Test (test_operations.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_operations.py"
        }
    }
}
