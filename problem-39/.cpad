{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_prefix_tree_py": {
            "label": "Test (test_prefix_tree.py)",
            "command": "python src/test_prefix_tree.py"
        },
        "test_test_words_py": {
            "label": "Test (test_words.py)",
            "command": "python src/test_words.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_prefix_tree_py": {
            "label": "ipdb Test (test_prefix_tree.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_prefix_tree.py"
        },
        "dbg_test_test_words_py": {
            "label": "ipdb Test (test_words.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_words.py"
        }
    }
}
