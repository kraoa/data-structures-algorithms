{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_ship_within_days_py": {
            "label": "Test (test_ship_within_days.py)",
            "command": "python src/test_ship_within_days.py"
        },
        "test_test_shipping_py": {
            "label": "Test (test_shipping.py)",
            "command": "python src/test_shipping.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_ship_within_days_py": {
            "label": "ipdb Test (test_ship_within_days.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_ship_within_days.py"
        },
        "dbg_test_test_shipping_py": {
            "label": "ipdb Test (test_shipping.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_shipping.py"
        }
    }
}
