{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_matrix_py": {
            "label": "Test (test_matrix.py)",
            "command": "python src/test_matrix.py"
        },
        "test_test_maximal_square_py": {
            "label": "Test (test_maximal_square.py)",
            "command": "python src/test_maximal_square.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_matrix_py": {
            "label": "ipdb Test (test_matrix.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_matrix.py"
        },
        "dbg_test_test_maximal_square_py": {
            "label": "ipdb Test (test_maximal_square.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_maximal_square.py"
        }
    }
}
