{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_lcs_py": {
            "label": "Test (test_lcs.py)",
            "command": "python src/test_lcs.py"
        },
        "test_test_subsequences_py": {
            "label": "Test (test_subsequences.py)",
            "command": "python src/test_subsequences.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_lcs_py": {
            "label": "ipdb Test (test_lcs.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_lcs.py"
        },
        "dbg_test_test_subsequences_py": {
            "label": "ipdb Test (test_subsequences.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_subsequences.py"
        }
    }
}
