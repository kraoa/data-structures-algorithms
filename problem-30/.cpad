{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_max_product_py": {
            "label": "Test (test_max_product.py)",
            "command": "python src/test_max_product.py"
        },
        "test_test_subarray_py": {
            "label": "Test (test_subarray.py)",
            "command": "python src/test_subarray.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_max_product_py": {
            "label": "ipdb Test (test_max_product.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_max_product.py"
        },
        "dbg_test_test_subarray_py": {
            "label": "ipdb Test (test_subarray.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_subarray.py"
        }
    }
}
