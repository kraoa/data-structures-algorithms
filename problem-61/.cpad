{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_components_py": {
            "label": "Test (test_components.py)",
            "command": "python src/test_components.py"
        },
        "test_test_count_components_py": {
            "label": "Test (test_count_components.py)",
            "command": "python src/test_count_components.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_components_py": {
            "label": "ipdb Test (test_components.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_components.py"
        },
        "dbg_test_test_count_components_py": {
            "label": "ipdb Test (test_count_components.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_count_components.py"
        }
    }
}
