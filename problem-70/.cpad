{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_bridges_py": {
            "label": "Test (test_bridges.py)",
            "command": "python src/test_bridges.py"
        },
        "test_test_critical_connections_py": {
            "label": "Test (test_critical_connections.py)",
            "command": "python src/test_critical_connections.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_bridges_py": {
            "label": "ipdb Test (test_bridges.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_bridges.py"
        },
        "dbg_test_test_critical_connections_py": {
            "label": "ipdb Test (test_critical_connections.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_critical_connections.py"
        }
    }
}
