{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_ladder_py": {
            "label": "Test (test_ladder.py)",
            "command": "python src/test_ladder.py"
        },
        "test_test_word_ladder_py": {
            "label": "Test (test_word_ladder.py)",
            "command": "python src/test_word_ladder.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_ladder_py": {
            "label": "ipdb Test (test_ladder.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_ladder.py"
        },
        "dbg_test_test_word_ladder_py": {
            "label": "ipdb Test (test_word_ladder.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_word_ladder.py"
        }
    }
}
