{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_lis_py": {
            "label": "Test (test_lis.py)",
            "command": "python src/test_lis.py"
        },
        "test_test_sequences_py": {
            "label": "Test (test_sequences.py)",
            "command": "python src/test_sequences.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_lis_py": {
            "label": "ipdb Test (test_lis.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_lis.py"
        },
        "dbg_test_test_sequences_py": {
            "label": "ipdb Test (test_sequences.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_sequences.py"
        }
    }
}
