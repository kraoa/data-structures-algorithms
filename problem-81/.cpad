{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_basic_calculator_py": {
            "label": "Test (test_basic_calculator.py)",
            "command": "python src/test_basic_calculator.py"
        },
        "test_test_calculator_py": {
            "label": "Test (test_calculator.py)",
            "command": "python src/test_calculator.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_basic_calculator_py": {
            "label": "ipdb Test (test_basic_calculator.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_basic_calculator.py"
        },
        "dbg_test_test_calculator_py": {
            "label": "ipdb Test (test_calculator.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_calculator.py"
        }
    }
}