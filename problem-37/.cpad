{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_equal_subset_py": {
            "label": "Test (test_equal_subset.py)",
            "command": "python src/test_equal_subset.py"
        },
        "test_test_partitions_py": {
            "label": "Test (test_partitions.py)",
            "command": "python src/test_partitions.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_equal_subset_py": {
            "label": "ipdb Test (test_equal_subset.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_equal_subset.py"
        },
        "dbg_test_test_partitions_py": {
            "label": "ipdb Test (test_partitions.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_partitions.py"
        }
    }
}
