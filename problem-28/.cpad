{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_grid_py": {
            "label": "Test (test_grid.py)",
            "command": "python src/test_grid.py"
        },
        "test_test_water_flow_py": {
            "label": "Test (test_water_flow.py)",
            "command": "python src/test_water_flow.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_grid_py": {
            "label": "ipdb Test (test_grid.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_grid.py"
        },
        "dbg_test_test_water_flow_py": {
            "label": "ipdb Test (test_water_flow.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_water_flow.py"
        }
    }
}
