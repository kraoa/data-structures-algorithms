{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_game_py": {
            "label": "Test (test_game.py)",
            "command": "python src/test_game.py"
        },
        "test_test_predict_winner_py": {
            "label": "Test (test_predict_winner.py)",
            "command": "python src/test_predict_winner.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_game_py": {
            "label": "ipdb Test (test_game.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_game.py"
        },
        "dbg_test_test_predict_winner_py": {
            "label": "ipdb Test (test_predict_winner.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_predict_winner.py"
        }
    }
}
