{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_segmentation_py": {
            "label": "Test (test_segmentation.py)",
            "command": "python src/test_segmentation.py"
        },
        "test_test_word_break_py": {
            "label": "Test (test_word_break.py)",
            "command": "python src/test_word_break.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_segmentation_py": {
            "label": "ipdb Test (test_segmentation.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_segmentation.py"
        },
        "dbg_test_test_word_break_py": {
            "label": "ipdb Test (test_word_break.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_word_break.py"
        }
    }
}
