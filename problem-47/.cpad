{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_maximal_rect_py": {
            "label": "Test (test_maximal_rect.py)",
            "command": "python src/test_maximal_rect.py"
        },
        "test_test_rectangle_py": {
            "label": "Test (test_rectangle.py)",
            "command": "python src/test_rectangle.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_maximal_rect_py": {
            "label": "ipdb Test (test_maximal_rect.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_maximal_rect.py"
        },
        "dbg_test_test_rectangle_py": {
            "label": "ipdb Test (test_rectangle.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_rectangle.py"
        }
    }
