{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_intervals_py": {
            "label": "Test (test_intervals.py)",
            "command": "python src/test_intervals.py"
        },
        "test_test_meeting_rooms_py": {
            "label": "Test (test_meeting_rooms.py)",
            "command": "python src/test_meeting_rooms.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_intervals_py": {
            "label": "ipdb Test (test_intervals.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_intervals.py"
        },
        "dbg_test_test_meeting_rooms_py": {
            "label": "ipdb Test (test_meeting_rooms.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_meeting_rooms.py"
        }
    }
}
