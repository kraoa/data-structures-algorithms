{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_bits_py": {
            "label": "Test (test_bits.py)",
            "command": "python src/test_bits.py"
        },
        "test_test_single_number_py": {
            "label": "Test (test_single_number.py)",
            "command": "python src/test_single_number.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_bits_py": {
            "label": "ipdb Test (test_bits.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_bits.py"
        },
        "dbg_test_test_single_number_py": {
            "label": "ipdb Test (test_single_number.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_single_number.py"
        }
    }
}
