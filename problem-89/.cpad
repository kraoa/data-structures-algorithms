{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_jump_game_vi_py": {
            "label": "Test (test_jump_game_vi.py)",
            "command": "python src/test_jump_game_vi.py"
        },
        "test_test_leaps_py": {
            "label": "Test (test_leaps.py)",
            "command": "python src/test_leaps.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_jump_game_vi_py": {
            "label": "ipdb Test (test_jump_game_vi.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_jump_game_vi.py"
        },
        "dbg_test_test_leaps_py": {
            "label": "ipdb Test (test_leaps.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_leaps.py"
        }
    }
}