{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_find_all_py": {
            "label": "Test (test_find_all.py)",
            "command": "python src/test_find_all.py"
        },
        "test_test_matching_py": {
            "label": "Test (test_matching.py)",
            "command": "python src/test_matching.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_find_all_py": {
            "label": "ipdb Test (test_find_all.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_find_all.py"
        },
        "dbg_test_test_matching_py": {
            "label": "ipdb Test (test_matching.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_matching.py"
        }
    }
}
