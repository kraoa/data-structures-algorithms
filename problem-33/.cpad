{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_gas_station_py": {
            "label": "Test (test_gas_station.py)",
            "command": "python src/test_gas_station.py"
        },
        "test_test_stations_py": {
            "label": "Test (test_stations.py)",
            "command": "python src/test_stations.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_gas_station_py": {
            "label": "ipdb Test (test_gas_station.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_gas_station.py"
        },
        "dbg_test_test_stations_py": {
            "label": "ipdb Test (test_stations.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_stations.py"
        }
    }
}
