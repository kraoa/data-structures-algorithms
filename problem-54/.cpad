{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_regions_py": {
            "label": "Test (test_regions.py)",
            "command": "python src/test_regions.py"
        },
        "test_test_surrounded_regions_py": {
            "label": "Test (test_surrounded_regions.py)",
            "command": "python src/test_surrounded_regions.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_regions_py": {
            "label": "ipdb Test (test_regions.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_regions.py"
        },
        "dbg_test_test_surrounded_regions_py": {
            "label": "ipdb Test (test_surrounded_regions.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_surrounded_regions.py"
        }
    }
}
