{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_cities_py": {
            "label": "Test (test_cities.py)",
            "command": "python src/test_cities.py"
        },
        "test_test_find_city_py": {
            "label": "Test (test_find_city.py)",
            "command": "python src/test_find_city.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_cities_py": {
            "label": "ipdb Test (test_cities.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_cities.py"
        },
        "dbg_test_test_find_city_py": {
            "label": "ipdb Test (test_find_city.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_find_city.py"
        }
    }
}