{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_cycle_py": {
            "label": "Test (test_cycle.py)",
            "command": "python src/test_cycle.py"
        },
        "test_test_detect_cycle_py": {
            "label": "Test (test_detect_cycle.py)",
            "command": "python src/test_detect_cycle.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_cycle_py": {
            "label": "ipdb Test (test_cycle.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_cycle.py"
        },
        "dbg_test_test_detect_cycle_py": {
            "label": "ipdb Test (test_detect_cycle.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_detect_cycle.py"
        }
    }
}
