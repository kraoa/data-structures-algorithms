{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_reversal_py": {
            "label": "Test (test_reversal.py)",
            "command": "python src/test_reversal.py"
        },
        "test_test_reverse_k_group_py": {
            "label": "Test (test_reverse_k_group.py)",
            "command": "python src/test_reverse_k_group.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_reversal_py": {
            "label": "ipdb Test (test_reversal.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_reversal.py"
        },
        "dbg_test_test_reverse_k_group_py": {
            "label": "ipdb Test (test_reverse_k_group.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_reverse_k_group.py"
        }
    }
}
