{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_min_path_sum_py": {
            "label": "Test (test_min_path_sum.py)",
            "command": "python src/test_min_path_sum.py"
        },
        "test_test_paths_py": {
            "label": "Test (test_paths.py)",
            "command": "python src/test_paths.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_min_path_sum_py": {
            "label": "ipdb Test (test_min_path_sum.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_min_path_sum.py"
        },
        "dbg_test_test_paths_py": {
            "label": "ipdb Test (test_paths.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_paths.py"
        }
    }
}
