{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_decode_py": {
            "label": "Test (test_decode.py)",
            "command": "python src/test_decode.py"
        },
        "test_test_decodings_py": {
            "label": "Test (test_decodings.py)",
            "command": "python src/test_decodings.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_decode_py": {
            "label": "ipdb Test (test_decode.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_decode.py"
        },
        "dbg_test_test_decodings_py": {
            "label": "ipdb Test (test_decodings.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_decodings.py"
        }
    }
}
