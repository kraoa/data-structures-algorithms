{
    "targets": {
        "run_main_py": {
            "label": "Main (main.py)",
            "command": "python src/main.py"
        },
        "test_test_linked_list_py": {
            "label": "Test (test_linked_list.py)",
            "command": "python src/test_linked_list.py"
        },
        "test_test_merge_py": {
            "label": "Test (test_merge.py)",
            "command": "python src/test_merge.py"
        },
        "format": {
            "label": "Format",
            "command": "/home/coderpad/.local/bin/black src/"
        },
        "dbg_run_main_py": {
            "label": "ipdb Main (main.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/main.py"
        },
        "dbg_test_test_linked_list_py": {
            "label": "ipdb Test (test_linked_list.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_linked_list.py"
        },
        "dbg_test_test_merge_py": {
            "label": "ipdb Test (test_merge.py)",
            "command": "/home/coderpad/.local/bin/ipdb3 src/test_merge.py"
        }
    }
}
